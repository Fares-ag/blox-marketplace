# --- Blox KYC service ---
NODE_ENV=development
KYC_PORT=3020

# Postgres for the KYC service (SEPARATE database from the marketplace)
DATABASE_URL=postgresql://kyc:kyc@127.0.0.1:55433/blox_kyc?schema=public

# Service-to-service auth: the marketplace API calls this service with this key.
# Generate: openssl rand -base64 48. MUST be set in every environment.
KYC_SERVICE_API_KEY=

# Field-level encryption key for sensitive data at rest (32-byte base64).
# Generate: openssl rand -base64 32. In production this must come from a KMS.
KYC_FIELD_ENCRYPTION_KEY=

# Data residency note: host DB + object storage + any CV service in-region (Qatar)
# per the QFC DPR posture. See docs/Blox_KYC_Build_Plan.md.
