  idempotencyKey   String                   @unique
  amount           Decimal                  @db.Decimal(12, 2)
  currency         String                   @default("QAR")
  status           PaymentTransactionStatus @default(pending)
  applicationId    String
  application      Application              @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  scheduleId       String?
  schedule         PaymentSchedule?         @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  rawPayloadRef    String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  paymentEvents PaymentEvent[]

  @@index([applicationId, status])
  @@index([scheduleId, status])
  @@map("payment_transactions")
}

/// Stores serialized responses for Idempotency-Key replays (scoped per user + route).
