enum GuarantorSessionStatus {
  pending
  otp_verified
  consents_done
  completed
  expired
  cancelled
}

/// A guarantor gives their own consents (and optionally completes KYC) from a link + OTP, like the assisted journey.
model GuarantorConsentSession {
  id                  String                  @id @default(cuid())
  token               String                  @unique
  applicationId       String                  @map("application_id")
  application         Application             @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdByUserId     String?                 @map("created_by_user_id")
  createdBy           User?                   @relation("GuarantorSessionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  fullName            String                  @map("full_name")
  phone               String
  email               String?
  qidHash             String?                 @map("qid_hash")
  relationship        String?
  status              GuarantorSessionStatus  @default(pending)
  otpCodeHash         String?                 @map("otp_code_hash")
  otpExpiresAt        DateTime?               @map("otp_expires_at")
  otpAttempts         Int                     @default(0) @map("otp_attempts")
  otpLockedUntil      DateTime?               @map("otp_locked_until")
  otpResendCount      Int                     @default(0) @map("otp_resend_count")
  otpResendWindowStart DateTime?              @map("otp_resend_window_start")
  otpVerifiedAt       DateTime?               @map("otp_verified_at")
  proofHash           String?                 @map("proof_hash")
  /// [{ code, version, textHash, locale, acceptedAt }] — the guarantor is not a User, so acceptances live here.
  acceptances         Json?
  consentsCompletedAt DateTime?               @map("consents_completed_at")
  ipAddress           String?                 @map("ip_address")
  userAgent           String?                 @map("user_agent")
  kycCaseId           String?                 @map("kyc_case_id")
  kycInviteUrl        String?                 @map("kyc_invite_url")
  kycStatus           String?                 @map("kyc_status")
  completedAt         DateTime?               @map("completed_at")
  expiresAt           DateTime                @map("expires_at")
  lastOpenedAt        DateTime?               @map("last_opened_at")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")

  @@index([applicationId, status])
  @@map("guarantor_consent_sessions")
}

/// Takaful provider master for indicative quote comparison (admin-maintained rates).
model TakafulProvider {
  id                   String   @id @default(cuid())
  code                 String   @unique
  name                 String
