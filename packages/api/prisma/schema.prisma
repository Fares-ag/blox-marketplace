  principalDiscountMinAmount Decimal   @default(0) @map("principal_discount_min_amount") @db.Decimal(12, 2)
  interestDiscountEnabled    Boolean   @default(false) @map("interest_discount_enabled")
  interestDiscountType       String    @default("percentage") @map("interest_discount_type")
  interestDiscountValue      Decimal   @default(0) @map("interest_discount_value") @db.Decimal(10, 2)
  interestDiscountMinAmount  Decimal   @default(0) @map("interest_discount_min_amount") @db.Decimal(12, 2)
  isActive                   Boolean   @default(true) @map("is_active")
  minSettlementAmount        Decimal   @default(0) @map("min_settlement_amount") @db.Decimal(12, 2)
  minRemainingPayments       Int       @default(1) @map("min_remaining_payments")
  maxDiscountAmount          Decimal?  @map("max_discount_amount") @db.Decimal(12, 2)
  maxDiscountPercentage      Decimal?  @map("max_discount_percentage") @db.Decimal(5, 2)
  tieredDiscounts            Json      @default("[]") @map("tiered_discounts")
  validFrom                  DateTime? @map("valid_from") @db.Date
  validUntil                 DateTime? @map("valid_until") @db.Date
  priority                   Int       @default(0)
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  @@map("settlement_discount_settings")
}

