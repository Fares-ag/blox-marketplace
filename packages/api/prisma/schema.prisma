/// Append-only diminishing musharakah ownership register (1:1 with Application).
model OwnershipRegister {
  id               String   @id @default(cuid())
  applicationId    String   @unique @map("application_id")
  application      Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  totalUnits       Int      @default(100) @map("total_units")
  customerUnits    Int      @default(0) @map("customer_units")
  bloxUnits        Int      @default(100) @map("blox_units")
  vehiclePrice     Decimal  @map("vehicle_price") @db.Decimal(12, 2)
  unitNominalValue Decimal  @map("unit_nominal_value") @db.Decimal(12, 2)
  openedAt         DateTime @default(now()) @map("opened_at")
  maturedAt        DateTime? @map("matured_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  entries OwnershipRegisterEntry[]

  @@map("ownership_registers")
}

/// Immutable ownership ledger rows. Updates and deletes are blocked by a DB trigger.
model OwnershipRegisterEntry {
  id                 String                     @id @default(cuid())
  registerId         String                     @map("register_id")
  register           OwnershipRegister          @relation(fields: [registerId], references: [id], onDelete: Cascade)
  eventType          OwnershipRegisterEventType @map("event_type")
  unitsDelta         Int                        @map("units_delta")
  customerUnitsAfter Int                        @map("customer_units_after")
  bloxUnitsAfter     Int                        @map("blox_units_after")
  paymentEventId     String?                    @map("payment_event_id")
  actorUserId        String?                    @map("actor_user_id")
  metadata           Json?
  createdAt          DateTime                   @default(now()) @map("created_at")

  @@index([registerId, createdAt])
  @@map("ownership_register_entries")
}

/// Separate rent (profit) pool for Sharia audit — never mixed with unit purchase.
model RentPoolLedgerEntry {
  id            String            @id @default(cuid())
  applicationId String            @map("application_id")
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          RentPoolEntryType
  amount        Decimal           @db.Decimal(12, 2)
  period        Int?
  paymentEventId String?          @map("payment_event_id")
  actorUserId   String?           @map("actor_user_id")
  metadata      Json?
  createdAt     DateTime          @default(now()) @map("created_at")

  @@index([applicationId, createdAt])
  @@map("rent_pool_ledger_entries")
}

model UnitOffer {
  id              String          @id @default(cuid())
  applicationId   String          @map("application_id")
  application     Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  period          Int
  unitsOffered    Int             @map("units_offered")
  unitPrice       Decimal         @map("unit_price") @db.Decimal(12, 2)
  rentAmount      Decimal         @map("rent_amount") @db.Decimal(12, 2)
  totalAmount     Decimal         @map("total_amount") @db.Decimal(12, 2)
  status          UnitOfferStatus @default(pending)
  offeredAt       DateTime?       @map("offered_at")
  acceptedAt      DateTime?       @map("accepted_at")
  paidAt          DateTime?       @map("paid_at")
  expiresAt       DateTime?       @map("expires_at")
  disclosureAckAt DateTime?       @map("disclosure_ack_at")
  scheduleId      String?         @map("schedule_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@unique([applicationId, period])
  @@index([status, offeredAt])
  @@map("unit_offers")
}

model LpoRecord {
  id              String    @id @default(cuid())
  applicationId   String    @map("application_id")
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  dealerCompanyId String    @map("dealer_company_id")
  status          LpoStatus @default(issued)
  amount          Decimal   @db.Decimal(12, 2)
  reference       String?
  issuedByUserId  String    @map("issued_by_user_id")
  issuedAt        DateTime  @default(now()) @map("issued_at")
  settledAt       DateTime? @map("settled_at")
  settledByUserId String?   @map("settled_by_user_id")
  settlementRef   String?   @map("settlement_ref")
  cancelledAt     DateTime? @map("cancelled_at")
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([applicationId, status])
  @@index([dealerCompanyId, status])
  @@map("lpo_records")
}

model CollectionsCase {
  id            String                 @id @default(cuid())
  applicationId String                 @map("application_id")
  application   Application            @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status        CollectionsCaseStatus  @default(open)
  reason        String?
  openedByUserId String?               @map("opened_by_user_id")
  openedAt      DateTime               @default(now()) @map("opened_at")
  closedAt      DateTime?              @map("closed_at")
  metadata      Json?
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  hardshipPlans HardshipPlan[]

  @@index([applicationId, status])
  @@index([status, openedAt])
  @@map("collections_cases")
}

model HardshipPlan {
  id                 String             @id @default(cuid())
  applicationId      String             @map("application_id")
  application        Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  collectionsCaseId  String?            @map("collections_case_id")
  collectionsCase    CollectionsCase?   @relation(fields: [collectionsCaseId], references: [id], onDelete: SetNull)
  status             HardshipPlanStatus @default(proposed)
  proposedByUserId   String             @map("proposed_by_user_id")
  approvedByUserId   String?            @map("approved_by_user_id")
  installmentsDeferred Int              @default(0) @map("installments_deferred")
  overrideDeferQuota Boolean            @default(false) @map("override_defer_quota")
  notes              String?
  proposedAt         DateTime           @default(now()) @map("proposed_at")
  decidedAt          DateTime?          @map("decided_at")
  completedAt        DateTime?          @map("completed_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  @@index([applicationId, status])
  @@map("hardship_plans")
}

model RepossessionCase {
  id              String              @id @default(cuid())
  applicationId   String              @map("application_id")
  application     Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status          RepossessionStatus  @default(initiated)
  initiatedByUserId String            @map("initiated_by_user_id")
  recoveredAt     DateTime?           @map("recovered_at")
  soldAt          DateTime?           @map("sold_at")
  saleProceeds    Decimal?            @map("sale_proceeds") @db.Decimal(12, 2)
  customerShare   Decimal?            @map("customer_share") @db.Decimal(12, 2)
  bloxShare       Decimal?            @map("blox_share") @db.Decimal(12, 2)
  closedAt        DateTime?           @map("closed_at")
  notes           String?
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@index([applicationId, status])
  @@map("repossession_cases")
}

model TotalLossClaim {
  id              String               @id @default(cuid())
  applicationId   String               @map("application_id")
  application     Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  takafulPolicyId String?              @map("takaful_policy_id")
  takafulPolicy   TakafulPolicy?       @relation(fields: [takafulPolicyId], references: [id], onDelete: SetNull)
  status          TotalLossClaimStatus @default(filed)
  proceeds        Decimal?             @db.Decimal(12, 2)
  customerShare   Decimal?             @map("customer_share") @db.Decimal(12, 2)
  bloxShare       Decimal?             @map("blox_share") @db.Decimal(12, 2)
  filedByUserId   String               @map("filed_by_user_id")
  filedAt         DateTime             @default(now()) @map("filed_at")
  allocatedAt     DateTime?            @map("allocated_at")
  closedAt        DateTime?            @map("closed_at")
  notes           String?
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  @@index([applicationId, status])
  @@map("total_loss_claims")
}
