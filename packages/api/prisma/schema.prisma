}

/// Append-only payment ledger — never updated after insert.
model PaymentEvent {
  id            String              @id @default(cuid())
  applicationId String
  application   Application         @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  scheduleId    String?
  schedule      PaymentSchedule?    @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  transactionId String?
