  thirdPartyAnnual     Decimal? @map("third_party_annual") @db.Decimal(12, 2)
  minContribution      Decimal? @map("min_contribution") @db.Decimal(12, 2)
  /// [{ code, label, labelAr, annualAmount }]
  riders               Json?
  contactPhone         String?  @map("contact_phone")
  contactEmail         String?  @map("contact_email")
  website              String?
  notes                String?
  active               Boolean  @default(true)
  sortOrder            Int      @default(0) @map("sort_order")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("takaful_providers")
}

enum DataRightsRequestKind {
  access
  correction
  deletion
  consent_withdrawal
}

enum DataRightsRequestStatus {
  open
  in_progress
  completed
  rejected
}

/// Customer data-rights requests (Qatar PDPPL): access, correction, deletion, consent withdrawal.
model DataRightsRequest {
  id             String                  @id @default(cuid())
  userId         String                  @map("user_id")
  user           User                    @relation("DataRightsSubject", fields: [userId], references: [id], onDelete: Cascade)
  kind           DataRightsRequestKind
  status         DataRightsRequestStatus @default(open)
  details        String?
  consentCode    ConsentCode?            @map("consent_code")
  resolutionNote String?                 @map("resolution_note")
  handledById    String?                 @map("handled_by_id")
  handledBy      User?                   @relation("DataRightsHandler", fields: [handledById], references: [id], onDelete: SetNull)
  handledAt      DateTime?               @map("handled_at")
  /// Statutory response deadline (30 days from the request).
  dueAt          DateTime?               @map("due_at")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([userId])
  @@map("data_rights_requests")
}

