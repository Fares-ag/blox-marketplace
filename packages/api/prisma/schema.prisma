generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  customer
  dealer_agent
  credit_officer
  finance_officer
  admin
  super_admin
  group_admin
  /// Read-only NBFC / finance-provider staff (see PartnerModule).
  partner_viewer
}

enum OfficerScope {
  all
  assigned
}

enum CompanyKind {
  holding
  dealership
}

enum CompanyStatus {
  active
  inactive
}

enum ListingStatus {
  draft
  published
  reserved
  sold
  archived
}

enum VehicleCondition {
  new
  used
}

enum Transmission {
  automatic
  manual
}

enum Drivetrain {
  fwd
  rwd
  awd
  four_wd
}

enum BodyType {
  sedan
  suv
  coupe
  hatchback
  pickup
  van
  other
}

enum OfferStatus {
  active
  inactive
}

enum FinancingType {
  diminishing_musharakah
  ijarah
}

enum ContractDocumentType {
  ijarah_agreement
  musharakah_agreement
  ownership_rental_schedule
  credit_appraisal_memorandum
}

enum ContractDocumentAudience {
  customer
  ops
}

enum ContractDocumentStatus {
  pending
  generated
  signed_submitted
  verified
}

enum ApplicationStatus {
  draft
  under_review
  resubmission_required
  contract_signing_required
  contracts_submitted
  contract_under_review
  down_payment_required
  down_payment_submitted
  pending_finance_activation
  partner_processing
  lpo_issued
  acquisition_pending
  active
  hardship
  repossession_in_progress
  total_loss
  completed
  rejected
  submission_cancelled
}

enum DocumentCategory {
  qid
  id
  salary
  bank
  passport
  selfie
  license
  other
  cr
  computer_card
  rental_agreement
  signatory_id
  credit_bureau
  residence_proof
  employment_contract
  trade_license
  audited_financials
  tax_card
  business_bank
  guarantor_qid
  guarantor_salary
  guarantor_bank
  vehicle_quotation
  takaful_policy
  delivery_note
  registration_card
  vin_evidence
  lpo
  mandate_proof
  maturity_certificate
}

enum Gender {
  male
  female
  prefer_not_to_say
}

/// The four mandatory consents captured before an application is submitted.
enum ConsentCode {
  credit_bureau
  terms
  kyc_biometric
  aml
}

enum ConsentChannel {
  web
  mobile
  assisted
}

/// Identity and supporting documents a customer keeps in their vault, reusable across applications.
enum CustomerDocumentCategory {
  qid_front
  qid_back
  passport
  driving_licence
  residence_proof
  salary_certificate
  bank_statement
  other
}

enum TakafulStatus {
  declared
  pending_verification
  active
  expired
  closed
}

/// Sales-executive assisted journey: the customer completes OTP, consents and identity on their own device.
enum AssistedSessionStatus {
  pending
  otp_verified
  consents_done
  identity_started
  completed
  expired
  cancelled
}

/// How a finance provider engages with underwriting (LOS FSD §5.8).
enum FinancePartnerEngagementMode {
  full_los_underwriting
  credit_file_handoff
}

enum BreOwnership {
  blox_bre_only
  blox_plus_partner_bre
}

enum CrmAdapter {
  none
  zoho
}

enum ScheduleStatus {
  pending
  paid
  overdue
  waived
}

enum PaymentTransactionStatus {
  pending
  completed
  failed
}

enum PaymentEventType {
  down_payment
  installment
  waive
  adjustment
  reversal
  /// Installment settled from the customer Blox-credits wallet (ledger reference = credit transaction id).
  blox_credits
  unit_purchase
  settlement
  total_loss_proceeds
  repossession_proceeds
}

enum EmailOutboxStatus {
  pending
  sent
  failed
}

enum ComplianceCheckStatus {
  pass
  fail
  pending
}

/// Better Auth + DriveMarket profile (single user table)
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  role         UserRole     @default(customer)
  companyId    String?
  company      Company?     @relation(fields: [companyId], references: [id])
  creditScope  OfficerScope @default(assigned)
  financeScope OfficerScope @default(assigned)
  phone        String?
  qid          String?
  /// HMAC blind index of the QID — lets us de-duplicate identities without querying plaintext.
  qidHash      String?      @map("qid_hash")
  /// AES-256-GCM copy of the QID (IdentityService). The plaintext column is retired once backfilled.
  qidEnc       String?      @map("qid_enc")
  isActive     Boolean      @default(true)

  /// Customer profile (self-service, see MeController)
  firstName               String?   @map("first_name")
  lastName                String?   @map("last_name")
  gender                  Gender?
  dateOfBirth             DateTime? @map("date_of_birth") @db.Date
  nationality             String?
  preferredLanguage       String    @default("en") @map("preferred_language")
  notificationPreferences Json?     @map("notification_preferences")
  address                 Json?

  /// Dealer staff: the branch they work from (drives lead attribution and branch-scoped views).
  homeBranchId String? @map("home_branch_id")
  homeBranch   Branch? @relation("BranchStaff", fields: [homeBranchId], references: [id], onDelete: SetNull)

  /// Partner viewers belong to a finance provider instead of a dealer company.
  financePartnerId String?         @map("finance_partner_id")
  financePartner   FinancePartner? @relation("PartnerViewers", fields: [financePartnerId], references: [id], onDelete: SetNull)

  /// Better Auth two-factor plugin
  twoFactorEnabled    Boolean   @default(false)
  /// Privileged-role password sign-in lockout (separate from 2FA verification lockout)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  sessions  Session[]
  accounts  Account[]
  twoFactor TwoFactor?

  applications         Application[]         @relation("CustomerApplications")
  uploadedDocuments    ApplicationDocument[]
  notifications        Notification[]
  activityLogs         ActivityLog[]
  creditCompanies      CreditOfficerCompany[]
  financeCompanies     FinanceOfficerCompany[]
  agentApplications    Application[]         @relation("AgentApplications")
  createdQuotes        DealerQuote[]         @relation("QuoteCreator")
  paymentEvents        PaymentEvent[]
  complianceChecks     ComplianceCheck[]     @relation("ComplianceVerifier")
  idempotencyRecords   IdempotencyRecord[]
  userCredit           UserCredit?
  creditTransactions   CreditTransaction[]
  deviceTokens         DeviceToken[]
  mobileRefreshTokens  MobileRefreshToken[]
  paymentDeferrals     PaymentDeferral[]
  guarantorSessionsCreated GuarantorConsentSession[] @relation("GuarantorSessionCreator")
  dataRightsRequests   DataRightsRequest[]   @relation("DataRightsSubject")
  dataRightsHandled    DataRightsRequest[]   @relation("DataRightsHandler")
  consentRecords       ConsentRecord[]       @relation("ConsentSubject")
  consentsCaptured     ConsentRecord[]       @relation("ConsentActor")
  customerDocuments    CustomerDocument[]    @relation("VaultOwner")
  assistedSessions     AssistedSession[]     @relation("AssistedCustomer")
  assistedSessionsRun  AssistedSession[]     @relation("AssistedCreator")
  takafulPolicies      TakafulPolicy[]       @relation("TakafulCreator")

  @@index([qidHash])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

/// Better Auth TOTP / backup-code storage (`two-factor` plugin)
model TwoFactor {
  id                      String    @id @default(cuid())
  secret                  String
  backupCodes             String
  userId                  String    @unique
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@map("twoFactor")
}

model Company {
  id                  String        @id @default(cuid())
  name                String
  code                String?       @unique
  status              CompanyStatus @default(active)
  kind                CompanyKind   @default(dealership)
  parentCompanyId     String?       @map("parent_company_id")
  parentCompany       Company?      @relation("CompanyHierarchy", fields: [parentCompanyId], references: [id])
  childCompanies      Company[]     @relation("CompanyHierarchy")
  canPay              Boolean       @default(false)
  logoUrl             String?
  branding            Json?
  contactEmail        String?
  contactPhone        String?
  address             String?
  allowDirectActivate         Boolean       @default(false)
  separationOfDutiesEnabled   Boolean       @default(true)
  /// Per-company unit-offer loop (Phase 4). Global UNIT_OFFERS_ENABLED must also be on.
  unitOffersEnabled           Boolean       @default(false) @map("unit_offers_enabled")
  createdAt                   DateTime      @default(now())
  updatedAt                   DateTime      @updatedAt

  users            User[]
  products         Product[]
  offers           Offer[]
  applications     Application[]
  creditOfficers   CreditOfficerCompany[]
  financeOfficers  FinanceOfficerCompany[]
  dealerQuotes     DealerQuote[]
  branches         Branch[]

  @@index([parentCompanyId])
  @@map("companies")
}

/// A physical branch/showroom of a dealership. Sales executives belong to exactly one home branch.
model Branch {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code      String
  name      String
  city      String?
  address   String?
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  staff        User[]        @relation("BranchStaff")
  applications Application[]

  @@unique([companyId, code])
  @@index([companyId, active])
  @@map("branches")
}

model CreditOfficerCompany {
  userId    String
  companyId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@map("credit_officer_companies")
}

model FinanceOfficerCompany {
  userId    String
  companyId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@map("finance_officer_companies")
}

model FinancePartner {
  id         String     @id @default(cuid())
  code       String     @unique
  name       String
  active     Boolean    @default(true)
  crmAdapter CrmAdapter @default(none)
  /// Finance Provider Master (LOS FSD §5.8): fixed per provider, never per application.
  engagementMode  FinancePartnerEngagementMode @default(full_los_underwriting) @map("engagement_mode")
  breOwnership    BreOwnership                 @default(blox_bre_only) @map("bre_ownership")
  /// Lender of record for offers that carry no explicit finance partner.
  isDefaultLender Boolean                      @default(false) @map("is_default_lender")
  contactName     String?                      @map("contact_name")
  contactEmail    String?                      @map("contact_email")
  contactPhone    String?                      @map("contact_phone")
  notes           String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  offers       Offer[]
  applications Application[]
  branches     FinancePartnerBranch[]
  viewers      User[]                 @relation("PartnerViewers")

  @@map("finance_partners")
}

model FinancePartnerBranch {
  id        String         @id @default(cuid())
  partnerId String         @map("partner_id")
  partner   FinancePartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  code      String
  name      String
  city      String?
  active    Boolean        @default(true)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  applications Application[]

  @@unique([partnerId, code])
  @@map("finance_partner_branches")
}

model Offer {
  id                 String      @id @default(cuid())
  name               String
  annualRentRate     Decimal     @db.Decimal(8, 4)
  profitRate         Decimal?    @db.Decimal(8, 4)
  tenureOptions      Json
  insuranceRateId    String?
  insuranceRate      InsuranceRate? @relation(fields: [insuranceRateId], references: [id], onDelete: SetNull)
  isDefault          Boolean     @default(false)
  status             OfferStatus @default(active)
  minDownPaymentPct  Decimal     @default(0) @db.Decimal(5, 2)
  companyId          String?
  company            Company?    @relation(fields: [companyId], references: [id])
  financePartnerId   String?
  financePartner     FinancePartner? @relation(fields: [financePartnerId], references: [id])
  financingType      FinancingType @default(diminishing_musharakah)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  products     Product[]
  applications Application[]
  dealerQuotes DealerQuote[]

  @@map("offers")
}

model Product {
  id              String           @id @default(cuid())
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id])
  slug            String           @unique
  make            String
  model           String
  trim            String?
  modelYear       Int
  condition       VehicleCondition @default(used)
  engine          String?
  transmission    Transmission?
  cylinders       Int?
  drivetrain      Drivetrain?
  bodyType        BodyType?
  warrantyMonths  Int?
  warrantyNotes   String?
  color           String?
  mileage         Int?
  vin             String?
  chassisNumber   String?
  /// Required together with VIN and chassis before a listing can be reserved by a submitted application.
  engineNumber    String?          @map("engine_number")
  description     String?
  attributes      Json?
  price           Decimal          @db.Decimal(12, 2)
  financeEligible Boolean          @default(true)
  defaultOfferId  String?
  defaultOffer    Offer?           @relation(fields: [defaultOfferId], references: [id])
  listingStatus   ListingStatus    @default(draft)
  publishedAt     DateTime?
  featuredUntil   DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  images       ProductImage[]
  applications Application[]
  dealerQuotes DealerQuote[]

  @@index([listingStatus, publishedAt])
  @@index([make])
  @@index([modelYear])
  @@index([price])
  @@index([companyId, listingStatus])
  @@map("products")
}

model ProductImage {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  storagePath String
  sortOrder   Int      @default(0)
  altText     String?
  createdAt   DateTime @default(now())

  @@index([productId, sortOrder])
  @@map("product_images")
}

model Application {
  id                 String            @id @default(cuid())
  /// Human-friendly sequential reference, surfaced as BLOX-#### in the UI and contracts.
  referenceSeq       Int               @unique @default(autoincrement()) @map("reference_seq")
  customerUserId     String?
  customer           User?             @relation("CustomerApplications", fields: [customerUserId], references: [id])
  customerEmail      String
  customerSnapshot   Json
  productId          String
  product            Product           @relation(fields: [productId], references: [id])
  companyId          String
  company            Company           @relation(fields: [companyId], references: [id])
  offerId            String
  offer              Offer             @relation(fields: [offerId], references: [id])
  financePartnerId   String?
  financePartner     FinancePartner?   @relation(fields: [financePartnerId], references: [id])
  leadSource         String?
  zohoLeadId         String?
  zohoSyncedAt       DateTime?
  zohoSyncError      String?
  zohoSyncAttempts   Int               @default(0)
  zohoNextRetryAt    DateTime?
  pricingSnapshot    Json
  installmentPlan    Json?             @map("installment_plan")
  status             ApplicationStatus @default(draft)
  contractGenerated  Boolean           @default(false)
  contractData       Json?
  contractPdfPath    String?
  signedContractPath String?
  agentUserId        String?
  agent              User?             @relation("AgentApplications", fields: [agentUserId], references: [id])
  rejectionReason    String?
  resubmissionComment String?
  statusReason       String?
  submittedAt        DateTime?
  activatedAt        DateTime?
  completedAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  kycCaseId          String?           @map("kyc_case_id")
  kycStatus          String?           @map("kyc_status")
  bloxMembership     Json?             @map("blox_membership")

  /// Branch the application was originated from (sales executive's home branch or the dealer quote's branch).
  branchId               String?               @map("branch_id")
  branch                 Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  financePartnerBranchId String?               @map("finance_partner_branch_id")
  financePartnerBranch   FinancePartnerBranch? @relation(fields: [financePartnerBranchId], references: [id], onDelete: SetNull)

  /// Identity-level de-duplication (LOS FSD §5.3.1). Blind index of the applicant QID.
  qidHash                 String?   @map("qid_hash")
  /// MISMATCHED_IDENTITY hold: the QID matches another customer with a different name or date of birth.
  identityHoldReason      String?   @map("identity_hold_reason")
  identityHoldAt          DateTime? @map("identity_hold_at")
  identityHoldClearedAt   DateTime? @map("identity_hold_cleared_at")
  identityHoldClearedById String?   @map("identity_hold_cleared_by_id")
  /// Set when all four mandatory consents were captured for this application.
  consentsCompletedAt     DateTime? @map("consents_completed_at")
  /// Server-side credit assessment captured at submission (shared credit-assessment module).
  creditAssessment        Json?     @map("credit_assessment")
  approvalAuthority       String?   @map("approval_authority")
  lastKycWebhookEventId   String?   @map("last_kyc_webhook_event_id")
  lastKycWebhookAt        DateTime? @map("last_kyc_webhook_at")
  repaymentMandateAt      DateTime? @map("repayment_mandate_at")
  repaymentMandateRef     String?   @map("repayment_mandate_ref")
  repaymentMandateStatus  MandateStatus? @map("repayment_mandate_status")
  preDisbursalCompletedAt DateTime? @map("pre_disbursal_completed_at")
  defaultClassification   DefaultClassification? @map("default_classification")
  unitOfferDisclosureAckAt DateTime? @map("unit_offer_disclosure_ack_at")

  documents         ApplicationDocument[]
  paymentSchedules  PaymentSchedule[]
  paymentTransactions PaymentTransaction[]
  paymentEvents     PaymentEvent[]
  redeemedQuote     DealerQuote?      @relation("QuoteRedemption")
  complianceChecks  ComplianceCheck[]
  paymentDeferrals  PaymentDeferral[]
  settlements       ApplicationSettlement[]
  consentRecords    ConsentRecord[]
  takafulPolicies   TakafulPolicy[]
  assistedSessions  AssistedSession[]
  guarantorSessions GuarantorConsentSession[]
  ownershipRegister OwnershipRegister?
  unitOffers        UnitOffer[]
  lpoRecords        LpoRecord[]
  collectionsCases  CollectionsCase[]
  hardshipPlans     HardshipPlan[]
  repossessionCases RepossessionCase[]
  totalLossClaims   TotalLossClaim[]
  rentPoolEntries    RentPoolLedgerEntry[]
  contractDocuments  ContractDocument[]

  @@index([customerUserId, status])
  @@index([companyId, status])
  @@index([productId, status])
  @@index([status, createdAt])
  @@index([kycCaseId])
  @@index([qidHash])
  @@index([branchId])
  @@map("applications")
}

/// Immutable consent ledger — one row per consent code per capture. Never updated or deleted.
model ConsentRecord {
  id            String         @id @default(cuid())
  userId        String         @map("user_id")
  user          User           @relation("ConsentSubject", fields: [userId], references: [id], onDelete: Cascade)
  applicationId String?        @map("application_id")
  application   Application?   @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  code          ConsentCode
  /// Version of the consent text the customer saw (from the shared consent catalog).
  version       String
  /// SHA-256 of the exact text shown, so the wording can be proven later.
  textHash      String         @map("text_hash")
  locale        String         @default("en")
  channel       ConsentChannel @default(web)
  acceptedAt    DateTime       @default(now()) @map("accepted_at")
  ipAddress     String?        @map("ip_address")
  userAgent     String?        @map("user_agent")
  sessionId     String?        @map("session_id")
  deviceInfo    Json?          @map("device_info")
  withdrawnAt   DateTime?      @map("withdrawn_at")
  withdrawalReason String?     @map("withdrawal_reason")
  /// Staff member present when the consent was captured on the customer's device (assisted journey).
  actorUserId   String?        @map("actor_user_id")
  actor         User?          @relation("ConsentActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([userId, code, acceptedAt])
  @@index([applicationId, code])
  @@map("consent_records")
}

/// Customer document vault — identity and income documents kept on the profile and reusable across applications.
model CustomerDocument {
  id                 String                   @id @default(cuid())
  userId             String                   @map("user_id")
  user               User                     @relation("VaultOwner", fields: [userId], references: [id], onDelete: Cascade)
  category           CustomerDocumentCategory
  storagePath        String                   @map("storage_path")
  mimeType           String?                  @map("mime_type")
  originalName       String?                  @map("original_name")
  sizeBytes          Int?                     @map("size_bytes")
  /// AES-256-GCM encrypted document number (QID, passport or licence number).
  documentNumberEnc  String?                  @map("document_number_enc")
  issuedAt           DateTime?                @map("issued_at") @db.Date
  expiresAt          DateTime?                @map("expires_at") @db.Date
  verifiedAt         DateTime?                @map("verified_at")
  verifiedById       String?                  @map("verified_by_id")
  lastReminderKind   String?                  @map("last_reminder_kind")
  lastReminderAt     DateTime?                @map("last_reminder_at")
  deletedAt          DateTime?                @map("deleted_at")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  @@index([userId, category])
  @@index([expiresAt])
  @@map("customer_documents")
}

/// Takaful (vehicle insurance) declaration and policy details captured at signing; renewals tracked on expiry.
model TakafulPolicy {
  id                    String        @id @default(cuid())
  applicationId         String        @map("application_id")
  application           Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  provider              String
  policyNumber          String?       @map("policy_number")
  coverageType          String?       @map("coverage_type")
  coverageAmount        Decimal?      @map("coverage_amount") @db.Decimal(12, 2)
  premiumAmount         Decimal?      @map("premium_amount") @db.Decimal(12, 2)
  issuedAt              DateTime?     @map("issued_at") @db.Date
  effectiveFrom         DateTime?     @map("effective_from") @db.Date
  expiresAt             DateTime?     @map("expires_at") @db.Date
  riders                Json?
  status                TakafulStatus @default(declared)
  declarationAcceptedAt DateTime?     @map("declaration_accepted_at")
  declarationVersion    String?       @map("declaration_version")
  documentPath          String?       @map("document_path")
  documentMime          String?       @map("document_mime")
  verifiedAt            DateTime?     @map("verified_at")
  verifiedById          String?       @map("verified_by_id")
  closedAt              DateTime?     @map("closed_at")
  lastReminderKind      String?       @map("last_reminder_kind")
  lastReminderAt        DateTime?     @map("last_reminder_at")
  createdByUserId       String        @map("created_by_user_id")
  createdBy             User          @relation("TakafulCreator", fields: [createdByUserId], references: [id])
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  totalLossClaims TotalLossClaim[]

  @@index([applicationId, status])
  @@index([expiresAt])
  @@map("takaful_policies")
}

/// Sales-executive assisted application: the customer verifies by OTP, consents and starts identity checks on their own phone.
model AssistedSession {
  id                   String                @id @default(cuid())
  token                String                @unique
  applicationId        String                @map("application_id")
  application          Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  customerUserId       String                @map("customer_user_id")
  customer             User                  @relation("AssistedCustomer", fields: [customerUserId], references: [id], onDelete: Cascade)
  createdByUserId      String                @map("created_by_user_id")
  createdBy            User                  @relation("AssistedCreator", fields: [createdByUserId], references: [id])
  phone                String
  email                String?
  status               AssistedSessionStatus @default(pending)
  otpCodeHash          String?               @map("otp_code_hash")
  otpExpiresAt         DateTime?             @map("otp_expires_at")
  otpAttempts          Int                   @default(0) @map("otp_attempts")
  otpLockedUntil       DateTime?             @map("otp_locked_until")
  otpResendCount       Int                   @default(0) @map("otp_resend_count")
  otpResendWindowStart DateTime?             @map("otp_resend_window_start")
  otpVerifiedAt        DateTime?             @map("otp_verified_at")
  /// Hash of the browser proof issued after OTP verification; required on every later call.
  proofHash            String?               @map("proof_hash")
  consentsCompletedAt  DateTime?             @map("consents_completed_at")
  identityStartedAt    DateTime?             @map("identity_started_at")
  completedAt          DateTime?             @map("completed_at")
  expiresAt            DateTime              @map("expires_at")
  lastOpenedAt         DateTime?             @map("last_opened_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  @@index([applicationId, status])
  @@map("assisted_sessions")
}

