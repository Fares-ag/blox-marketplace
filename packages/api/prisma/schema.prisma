  schedule     PaymentSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  kind         String
  reminderDate DateTime        @db.Date
  createdAt    DateTime        @default(now())

  @@unique([scheduleId, kind, reminderDate])
  @@map("payment_reminder_sent")
}

model PaymentTransaction {
  id               String                   @id @default(cuid())
  gateway          String                   @default("skipcash")
