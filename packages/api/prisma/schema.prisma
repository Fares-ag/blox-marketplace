generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  customer
  dealer_agent
  credit_officer
  finance_officer
  admin
  super_admin
  group_admin
}

enum OfficerScope {
  all
  assigned
}

enum CompanyKind {
  holding
  dealership
}

enum CompanyStatus {
  active
  inactive
}

enum ListingStatus {
  draft
  published
  reserved
  sold
  archived
}

enum VehicleCondition {
  new
  used
}

enum Transmission {
  automatic
  manual
}

enum Drivetrain {
  fwd
  rwd
  awd
  four_wd
}

enum BodyType {
  sedan
  suv
  coupe
  hatchback
  pickup
  van
  other
}

enum OfferStatus {
  active
  inactive
}

enum ApplicationStatus {
  draft
  under_review
  resubmission_required
  contract_signing_required
  contracts_submitted
  contract_under_review
  down_payment_required
  down_payment_submitted
  pending_finance_activation
  partner_processing
  active
  completed
  rejected
  submission_cancelled
}

enum DocumentCategory {
  qid
  id
  salary
  bank
  passport
  license
  other
  cr
  computer_card
  rental_agreement
  signatory_id
}

enum CrmAdapter {
  none
  zoho
}

enum ScheduleStatus {
  pending
  paid
  overdue
  waived
}

enum PaymentTransactionStatus {
  pending
  completed
  failed
}

enum PaymentEventType {
  down_payment
  installment
  waive
  adjustment
  reversal
}

enum EmailOutboxStatus {
  pending
  sent
  failed
}

enum ComplianceCheckStatus {
  pass
  fail
  pending
}

/// Better Auth + DriveMarket profile (single user table)
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  role         UserRole     @default(customer)
  companyId    String?
  company      Company?     @relation(fields: [companyId], references: [id])
  creditScope  OfficerScope @default(assigned)
  financeScope OfficerScope @default(assigned)
  phone        String?
  qid          String?
  isActive     Boolean      @default(true)

  /// Better Auth two-factor plugin
  twoFactorEnabled    Boolean   @default(false)
  /// Privileged-role password sign-in lockout (separate from 2FA verification lockout)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  sessions  Session[]
  accounts  Account[]
  twoFactor TwoFactor?

  applications         Application[]         @relation("CustomerApplications")
  uploadedDocuments    ApplicationDocument[]
  notifications        Notification[]
  activityLogs         ActivityLog[]
  creditCompanies      CreditOfficerCompany[]
  financeCompanies     FinanceOfficerCompany[]
  agentApplications    Application[]         @relation("AgentApplications")
  createdQuotes        DealerQuote[]         @relation("QuoteCreator")
  paymentEvents        PaymentEvent[]
  complianceChecks     ComplianceCheck[]     @relation("ComplianceVerifier")
  idempotencyRecords   IdempotencyRecord[]
  userCredit           UserCredit?
  creditTransactions   CreditTransaction[]
  deviceTokens         DeviceToken[]
  mobileRefreshTokens  MobileRefreshToken[]
  paymentDeferrals     PaymentDeferral[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

/// Better Auth TOTP / backup-code storage (`two-factor` plugin)
model TwoFactor {
  id                      String    @id @default(cuid())
  secret                  String
  backupCodes             String
  userId                  String    @unique
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@map("twoFactor")
}

model Company {
  id                  String        @id @default(cuid())
  name                String
  code                String?       @unique
  status              CompanyStatus @default(active)
  kind                CompanyKind   @default(dealership)
  parentCompanyId     String?       @map("parent_company_id")
  parentCompany       Company?      @relation("CompanyHierarchy", fields: [parentCompanyId], references: [id])
  childCompanies      Company[]     @relation("CompanyHierarchy")
  canPay              Boolean       @default(false)
  logoUrl             String?
  branding            Json?
  contactEmail        String?
  contactPhone        String?
  address             String?
  allowDirectActivate         Boolean       @default(false)
  separationOfDutiesEnabled   Boolean       @default(true)
  createdAt                   DateTime      @default(now())
  updatedAt                   DateTime      @updatedAt

  users            User[]
  products         Product[]
  offers           Offer[]
  applications     Application[]
  creditOfficers   CreditOfficerCompany[]
  financeOfficers  FinanceOfficerCompany[]
  dealerQuotes     DealerQuote[]

  @@index([parentCompanyId])
  @@map("companies")
}

model CreditOfficerCompany {
  userId    String
  companyId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@map("credit_officer_companies")
}

model FinanceOfficerCompany {
  userId    String
  companyId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@map("finance_officer_companies")
}

model FinancePartner {
  id         String     @id @default(cuid())
  code       String     @unique
  name       String
  active     Boolean    @default(true)
  crmAdapter CrmAdapter @default(none)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  offers       Offer[]
  applications Application[]

  @@map("finance_partners")
}

model Offer {
  id                 String      @id @default(cuid())
  name               String
  annualRentRate     Decimal     @db.Decimal(8, 4)
  profitRate         Decimal?    @db.Decimal(8, 4)
  tenureOptions      Json
  insuranceRateId    String?
  insuranceRate      InsuranceRate? @relation(fields: [insuranceRateId], references: [id], onDelete: SetNull)
  isDefault          Boolean     @default(false)
  status             OfferStatus @default(active)
  minDownPaymentPct  Decimal     @default(0) @db.Decimal(5, 2)
  companyId          String?
  company            Company?    @relation(fields: [companyId], references: [id])
  financePartnerId   String?
  financePartner     FinancePartner? @relation(fields: [financePartnerId], references: [id])
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  products     Product[]
  applications Application[]
  dealerQuotes DealerQuote[]

  @@map("offers")
}

model Product {
  id              String           @id @default(cuid())
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id])
  slug            String           @unique
  make            String
  model           String
  trim            String?
  modelYear       Int
  condition       VehicleCondition @default(used)
  engine          String?
  transmission    Transmission?
  cylinders       Int?
  drivetrain      Drivetrain?
  bodyType        BodyType?
  warrantyMonths  Int?
  warrantyNotes   String?
  color           String?
  mileage         Int?
  vin             String?
  chassisNumber   String?
  description     String?
  attributes      Json?
  price           Decimal          @db.Decimal(12, 2)
  financeEligible Boolean          @default(true)
  defaultOfferId  String?
  defaultOffer    Offer?           @relation(fields: [defaultOfferId], references: [id])
  listingStatus   ListingStatus    @default(draft)
  publishedAt     DateTime?
  featuredUntil   DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  images       ProductImage[]
  applications Application[]
  dealerQuotes DealerQuote[]

  @@index([listingStatus, publishedAt])
  @@index([make])
  @@index([modelYear])
  @@index([price])
  @@index([companyId, listingStatus])
  @@map("products")
}

model ProductImage {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  storagePath String
  sortOrder   Int      @default(0)
  altText     String?
  createdAt   DateTime @default(now())

  @@index([productId, sortOrder])
  @@map("product_images")
}

model Application {
  id                 String            @id @default(cuid())
  customerUserId     String
  customer           User              @relation("CustomerApplications", fields: [customerUserId], references: [id])
  customerEmail      String
  customerSnapshot   Json
  productId          String
  product            Product           @relation(fields: [productId], references: [id])
  companyId          String
  company            Company           @relation(fields: [companyId], references: [id])
  offerId            String
  offer              Offer             @relation(fields: [offerId], references: [id])
  financePartnerId   String?
  financePartner     FinancePartner?   @relation(fields: [financePartnerId], references: [id])
  leadSource         String?
  zohoLeadId         String?
  zohoSyncedAt       DateTime?
  zohoSyncError      String?
  zohoSyncAttempts   Int               @default(0)
  zohoNextRetryAt    DateTime?
  pricingSnapshot    Json
  installmentPlan    Json?             @map("installment_plan")
  status             ApplicationStatus @default(draft)
  contractGenerated  Boolean           @default(false)
  contractData       Json?
  contractPdfPath    String?
  signedContractPath String?
  agentUserId        String?
  agent              User?             @relation("AgentApplications", fields: [agentUserId], references: [id])
  rejectionReason    String?
  resubmissionComment String?
  statusReason       String?
  submittedAt        DateTime?
  activatedAt        DateTime?
  completedAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  kycCaseId          String?           @map("kyc_case_id")
  kycStatus          String?           @map("kyc_status")
  bloxMembership     Json?             @map("blox_membership")

  documents         ApplicationDocument[]
  paymentSchedules  PaymentSchedule[]
  paymentTransactions PaymentTransaction[]
  paymentEvents     PaymentEvent[]
  redeemedQuote     DealerQuote?      @relation("QuoteRedemption")
  complianceChecks  ComplianceCheck[]
  paymentDeferrals  PaymentDeferral[]
  settlements       ApplicationSettlement[]

  @@index([customerUserId, status])
  @@index([companyId, status])
  @@index([productId, status])
  @@index([status, createdAt])
  @@index([kycCaseId])
  @@map("applications")
}

model ApplicationDocument {
  id            String           @id @default(cuid())
  applicationId String
  application   Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  category      DocumentCategory
  storagePath   String
  mimeType      String?
  uploadedById  String
  uploadedBy    User             @relation(fields: [uploadedById], references: [id])
  createdAt     DateTime         @default(now())
  kycDocumentId   String?        @map("kyc_document_id")
  kycDocumentType String?        @map("kyc_document_type")
  verificationStatus String?     @map("verification_status")
  quality         Float?
  authenticity    Float?
  reviewStatus    String?        @map("review_status")
  originalName    String?        @map("original_name")

  @@index([applicationId, category])
  @@map("application_documents")
}

model ComplianceCheck {
  id               String                @id @default(cuid())
  applicationId    String
  application      Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  provider         String
  identityStatus   ComplianceCheckStatus @default(pending)
  sanctionsStatus  ComplianceCheckStatus @default(pending)
  overallStatus    ComplianceCheckStatus @default(pending)
  identityResult   Json?
  sanctionsResult  Json?
  verifiedByUserId String?
  verifiedBy       User?                 @relation("ComplianceVerifier", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  qidScreened      String
  applicantName    String
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([applicationId, createdAt])
  @@index([applicationId, overallStatus])
  @@map("compliance_checks")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  linkPath  String?
  readAt    DateTime?
  channel   String    @default("in_app")
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

model ActivityLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id])
  entityType  String
  entityId    String
  action      String
  fromValue   String?
  toValue     String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@map("activity_logs")
}

model PaymentSchedule {
  id                        String         @id @default(cuid())
  applicationId             String
  application               Application    @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  sequence                  Int
  dueDate                   DateTime       @db.Date
  amount                    Decimal        @db.Decimal(12, 2)
  paidAmount                Decimal        @default(0) @db.Decimal(12, 2)
  remainingAmount           Decimal        @db.Decimal(12, 2)
  status                    ScheduleStatus @default(pending)
  paymentMethod             String?
  paymentReference          String?
  paidAt                    DateTime?
  pendingWaiveReason        String?
  pendingWaiveRequestedById String?
  pendingWaiveRequestedAt   DateTime?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  transactions  PaymentTransaction[]
  paymentEvents PaymentEvent[]
  remindersSent PaymentReminderSent[]

  @@unique([applicationId, sequence])
  @@index([applicationId, status])
  @@index([status, dueDate])
  @@map("payment_schedules")
}

/// Cron dedup ledger — one reminder per schedule, kind, and UTC day.
model PaymentReminderSent {
  id           String          @id @default(cuid())
  scheduleId   String
  schedule     PaymentSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  kind         String
  reminderDate DateTime        @db.Date
  createdAt    DateTime        @default(now())

  @@unique([scheduleId, kind, reminderDate])
  @@map("payment_reminder_sent")
}

model PaymentTransaction {
  id               String                   @id @default(cuid())
  gateway          String                   @default("skipcash")
  gatewayPaymentId String?
  idempotencyKey   String                   @unique
  amount           Decimal                  @db.Decimal(12, 2)
  currency         String                   @default("QAR")
  status           PaymentTransactionStatus @default(pending)
  applicationId    String
  application      Application              @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  scheduleId       String?
  schedule         PaymentSchedule?         @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  rawPayloadRef    String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  paymentEvents PaymentEvent[]

  @@index([applicationId, status])
  @@index([scheduleId, status])
  @@map("payment_transactions")
}

/// Stores serialized responses for Idempotency-Key replays (scoped per user + route).
model IdempotencyRecord {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope          String
  idempotencyKey String
  statusCode     Int       @default(201)
  responseBody   Json?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  @@unique([userId, scope, idempotencyKey])
  @@index([createdAt])
  @@map("idempotency_records")
}

/// Append-only payment ledger — never updated after insert.
model PaymentEvent {
  id            String              @id @default(cuid())
  applicationId String
  application   Application         @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  scheduleId    String?
  schedule      PaymentSchedule?    @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  transactionId String?
  transaction   PaymentTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  type          PaymentEventType
  amount        Decimal             @db.Decimal(12, 2)
  currency      String              @default("QAR")
  actorUserId   String?
  actor         User?               @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  reason        String?
  metadata      Json?
  createdAt     DateTime            @default(now())

  @@index([applicationId, createdAt])
  @@index([scheduleId, createdAt])
  @@map("payment_events")
}

model DealerQuote {
  id                  String    @id @default(cuid())
  token               String    @unique
  productId           String
  product             Product   @relation(fields: [productId], references: [id])
  companyId           String
  company             Company   @relation(fields: [companyId], references: [id])
  createdByUserId     String
  createdBy           User      @relation("QuoteCreator", fields: [createdByUserId], references: [id])
  customerEmail       String
  listPriceSnapshot   Decimal   @db.Decimal(12, 2)
  negotiatedPrice     Decimal   @db.Decimal(12, 2)
  offerId             String
  offer               Offer     @relation(fields: [offerId], references: [id])
  expiresAt           DateTime
  usedAt              DateTime?
  usedByApplicationId String?   @unique
  usedByApplication   Application? @relation("QuoteRedemption", fields: [usedByApplicationId], references: [id])
  revokedAt           DateTime?
  expiredAt           DateTime?
  createdAt           DateTime  @default(now())

  @@index([companyId, createdAt])
  @@index([expiresAt, expiredAt])
  @@index([productId])
  @@map("dealer_quotes")
}

/// Durable outbound email queue — immediate send with retry/backoff for failures.
model EmailOutbox {
  id            String            @id @default(cuid())
  to            String
  subject       String
  template      String
  payload       Json
  status        EmailOutboxStatus @default(pending)
  attempts      Int               @default(0)
  lastError     String?
  nextAttemptAt DateTime?
  createdAt     DateTime          @default(now())
  sentAt        DateTime?

  @@index([status, nextAttemptAt])
  @@map("email_outbox")
}

model UserCredit {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Decimal  @default(0) @db.Decimal(18, 3)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_credits")
}

model CreditTransaction {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String
  amount      Decimal  @db.Decimal(18, 3)
  balanceAfter Decimal @map("balance_after") @db.Decimal(18, 3)
  description String?
  actorUserId String?  @map("actor_user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("credit_transactions")
}

model InsuranceRate {
  id                   String   @id @default(cuid())
  name                 String
  description          String?
  annualRate           Decimal  @map("annual_rate") @db.Decimal(5, 2)
  annualRateProvider   Decimal  @map("annual_rate_provider") @db.Decimal(5, 2)
  coverageType         String?  @map("coverage_type")
  minVehicleValue      Decimal? @map("min_vehicle_value") @db.Decimal(12, 2)
  maxVehicleValue      Decimal? @map("max_vehicle_value") @db.Decimal(12, 2)
  minTenure            Int?     @map("min_tenure")
  maxTenure            Int?     @map("max_tenure")
  status               String   @default("active")
  isDefault            Boolean  @default(false) @map("is_default")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  offers               Offer[]

  @@map("insurance_rates")
}

model Promotion {
  id                 String    @id @default(cuid())
  name               String
  description        String?
  discountPercentage Decimal?  @map("discount_percentage") @db.Decimal(5, 2)
  discountAmount     Decimal?  @map("discount_amount") @db.Decimal(12, 2)
  startDate          DateTime? @map("start_date") @db.Date
  endDate            DateTime? @map("end_date") @db.Date
  status             String    @default("active")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("promotions")
}

model Package {
  id          String   @id @default(cuid())
  name        String
  description String?
  items       Json     @default("[]")
  price       Decimal  @db.Decimal(12, 2)
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("packages")
}

enum SettlementStatus {
  pending
  approved
  rejected
  cancelled
}

/// Early-settlement request on an active financing (blox-vercel `application_settlements`).
/// Customer requests; finance/admin approve or reject. Money movement stays on the schedule ledger.
model ApplicationSettlement {
  id                 String           @id @default(cuid())
  applicationId      String           @map("application_id")
  application        Application      @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  customerUserId     String           @map("customer_user_id")
  customerEmail      String           @map("customer_email")
  status             SettlementStatus @default(pending)
  settlementAmount   Decimal          @map("settlement_amount") @db.Decimal(12, 2)
  remainingPrincipal Decimal          @map("remaining_principal") @db.Decimal(12, 2)
  discountAmount     Decimal          @default(0) @map("discount_amount") @db.Decimal(12, 2)
  forgivenRent       Decimal          @default(0) @map("forgiven_rent") @db.Decimal(12, 2)
  requestedAt        DateTime         @default(now()) @map("requested_at")
  decidedAt          DateTime?        @map("decided_at")
  decidedByUserId    String?          @map("decided_by_user_id")
  decisionReason     String?          @map("decision_reason")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  @@index([status, requestedAt])
  @@index([applicationId])
  @@map("application_settlements")
}

model SettlementDiscountSettings {
  id                         String    @id @default(cuid())
  name                       String    @default("Default Settlement Discount Settings")
  description                String?
  principalDiscountEnabled   Boolean   @default(false) @map("principal_discount_enabled")
  principalDiscountType      String    @default("percentage") @map("principal_discount_type")
  principalDiscountValue     Decimal   @default(0) @map("principal_discount_value") @db.Decimal(10, 2)
  principalDiscountMinAmount Decimal   @default(0) @map("principal_discount_min_amount") @db.Decimal(12, 2)
  interestDiscountEnabled    Boolean   @default(false) @map("interest_discount_enabled")
  interestDiscountType       String    @default("percentage") @map("interest_discount_type")
  interestDiscountValue      Decimal   @default(0) @map("interest_discount_value") @db.Decimal(10, 2)
  interestDiscountMinAmount  Decimal   @default(0) @map("interest_discount_min_amount") @db.Decimal(12, 2)
  isActive                   Boolean   @default(true) @map("is_active")
  minSettlementAmount        Decimal   @default(0) @map("min_settlement_amount") @db.Decimal(12, 2)
  minRemainingPayments       Int       @default(1) @map("min_remaining_payments")
  maxDiscountAmount          Decimal?  @map("max_discount_amount") @db.Decimal(12, 2)
  maxDiscountPercentage      Decimal?  @map("max_discount_percentage") @db.Decimal(5, 2)
  tieredDiscounts            Json      @default("[]") @map("tiered_discounts")
  validFrom                  DateTime? @map("valid_from") @db.Date
  validUntil                 DateTime? @map("valid_until") @db.Date
  priority                   Int       @default(0)
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  @@map("settlement_discount_settings")
}

model DeviceToken {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   String
  fcmToken   String   @unique @map("fcm_token")
  appVersion String?  @map("app_version")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("device_tokens")
}

model PaymentDeferral {
  id              String      @id @default(cuid())
  applicationId   String      @map("application_id")
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  userId          String      @map("user_id")
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentId       String?     @map("payment_id")
  originalDueDate DateTime    @map("original_due_date") @db.Date
  deferredToDate  DateTime    @map("deferred_to_date") @db.Date
  reason          String?
  year            Int?
  deferredAmount  Decimal     @default(0) @map("deferred_amount") @db.Decimal(12, 2)
  originalAmount  Decimal     @default(0) @map("original_amount") @db.Decimal(12, 2)
  createdAt       DateTime    @default(now()) @map("created_at")

  @@index([applicationId])
  @@index([userId])
  @@map("payment_deferrals")
}

model MobileRefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, expiresAt])
  @@map("mobile_refresh_tokens")
}

model MigrationIdMap {
  id         String   @id @default(cuid())
  entity     String
  sourceId   String   @map("source_id")
  targetId   String   @map("target_id")
  migratedAt DateTime @default(now()) @map("migrated_at")

  @@unique([entity, sourceId])
  @@index([entity, targetId])
  @@map("migration_id_map")
}

model MigrationError {
  id         String   @id @default(cuid())
  entity     String
  sourceId   String?  @map("source_id")
  message    String
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entity, createdAt])
  @@map("migration_errors")
}
