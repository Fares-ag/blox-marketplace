model PaymentSchedule {
  id                        String         @id @default(cuid())
  applicationId             String
  application               Application    @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  sequence                  Int
  dueDate                   DateTime       @db.Date
  amount                    Decimal        @db.Decimal(12, 2)
  paidAmount                Decimal        @default(0) @db.Decimal(12, 2)
  remainingAmount           Decimal        @db.Decimal(12, 2)
  status                    ScheduleStatus @default(pending)
  paymentMethod             String?
  paymentReference          String?
  paidAt                    DateTime?
  pendingWaiveReason        String?
  pendingWaiveRequestedById String?
  pendingWaiveRequestedAt   DateTime?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  transactions  PaymentTransaction[]
  paymentEvents PaymentEvent[]
  remindersSent PaymentReminderSent[]

  @@unique([applicationId, sequence])
  @@index([applicationId, status])
  @@index([status, dueDate])
  @@map("payment_schedules")
}

/// Cron dedup ledger — one reminder per schedule, kind, and UTC day.
model PaymentReminderSent {
  id           String          @id @default(cuid())
