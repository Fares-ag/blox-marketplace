# =============================================================================
# DriveMarket API — environment variables
# Copy to packages/api/.env (or repo root .env). See packages/api/src for usage.
# =============================================================================

# --- Required ---

# Postgres connection (Prisma). Used by packages/api/prisma/schema.prisma.
DATABASE_URL=postgresql://drivemarket:drivemarket@127.0.0.1:55432/drivemarket?schema=public

# Better Auth session signing secret (min ~32 chars). Required — API refuses to start without it.
BETTER_AUTH_SECRET=dev-change-me-to-a-long-random-string-32chars

# Public URL of this API (Better Auth callbacks, cookie scope). Required in production.
BETTER_AUTH_URL=http://localhost:3010

# Comma-separated browser origins allowed by CORS (all Vite app dev ports).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:5179

# --- Server ---

# Listen port when PORT is unset (local dev). Railway/Heroku set PORT instead.
API_PORT=3010

# Runtime port override (cloud hosts). Takes precedence over API_PORT.
# PORT=8080

# NODE_ENV=development
# NODE_ENV=production

# Cookie domain for cross-subdomain sessions (e.g. .blox.market). Omit for localhost.
# COOKIE_DOMAIN=

# Require verified email before sensitive flows. Defaults to true when NODE_ENV=production.
# REQUIRE_EMAIL_VERIFICATION=true

# Default lender name on generated contracts when no finance partner is linked.
# CONTRACT_LENDER_NAME=Blox Finance

# --- Object storage (S3-compatible) ---

# Omit S3_ENDPOINT to use local .uploads/ filesystem fallback.
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY=drivemarket
# S3_SECRET_KEY=drivemarketsecret
# S3_FORCE_PATH_STYLE=true

# S3_BUCKET_LISTINGS=listing-images
# S3_BUCKET_KYC=kyc-docs
# S3_BUCKET_CONTRACTS=contracts

# Public base URL for listing images (CDN or MinIO path-style URL).
# S3_PUBLIC_BASE_URL=http://127.0.0.1:9000/listing-images

# --- Payments (SkipCash) ---

# Allow unverified payment completion via redirect key (local sandbox only).
# MUST be false in production — production requires real gateway verification.
SKIPCASH_SANDBOX=true

# --- Compliance (KYC/AML screening before contract approval) ---

# stub (default) — runCheck fails until a vendor is integrated; approval blocked.
# synthetic — ops-run checks record a pass (pre-launch / staging only; auditable in compliance_checks).
# COMPLIANCE_PROVIDER=stub
# COMPLIANCE_PROVIDER=synthetic

# Legacy non-production shortcut (equivalent to COMPLIANCE_PROVIDER=synthetic when unset).
# Ignored when NODE_ENV=production — use COMPLIANCE_PROVIDER=synthetic in prod staging instead.
# COMPLIANCE_DEV_PROVIDER=true

# --- Email (Postmark recommended on Railway; SMTP for local/other hosts) ---

# Postmark HTTP API — preferred in production (Railway blocks outbound SMTP).
# Use your Postmark Server API token. Falls back to SMTP_USER when SMTP_HOST is
# smtp.postmarkapp.com.
# POSTMARK_SERVER_TOKEN=
# POSTMARK_HTTP_TIMEOUT_MS=30000

# SMTP fallback (local dev or non-Postmark providers).
# Omit SMTP_HOST to log emails to console / skip real delivery in dev.
# SMTP_HOST=smtp.postmarkapp.com
# SMTP_PORT=587
# SMTP_SECURE=false
# STARTTLS is required by default on submission ports against remote hosts, and
# skipped on port 25 or when SMTP_HOST is localhost/127.0.0.1 (Mailpit, MailHog).
# Force it either way with true/false.
# SMTP_REQUIRE_TLS=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Blox <no-reply@blox.market>

# --- Zoho CRM (optional integration) ---

# Leave ZOHO_CLIENT_ID empty to disable Zoho sync.
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
# ZOHO_API_DOMAIN=https://www.zohoapis.com
# ZOHO_HTTP_TIMEOUT_MS=8000
# ZOHO_REQUEST_SUBMITTED_TO=Al Jazeera Finance

# Zoho retry job tuning (packages/api/src/jobs/jobs.service.ts)
# ZOHO_RETRY_CRON_MINUTES=5
# ZOHO_MAX_SYNC_ATTEMPTS=10
# ZOHO_RETRY_BATCH_SIZE=5

# --- Background jobs (cron expressions) ---

# OVERDUE_SWEEP_CRON=0 0 * * *
# PAYMENT_REMINDERS_CRON=0 8 * * *
# QUOTE_EXPIRY_CRON=0 * * * *
# PAYMENT_REMINDER_DAYS_AHEAD=3
# EMAIL_OUTBOX_CRON_MINUTES=2
# EMAIL_OUTBOX_BATCH_SIZE=20

# --- Security / rate limiting ---

# Shared Redis URL for distributed rate limiting when running >1 API replica.
# Local dev: start Redis via `docker compose up -d redis` at repo root.
REDIS_URL=redis://127.0.0.1:6379

# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=300
# RATE_LIMIT_AUTH_MAX=30
# RATE_LIMIT_PUBLIC_MAX=120

# Better Auth session cookie cache (seconds). Default 60 — the upper bound on
# how long a revoked session (revoke-all, password reset, wrong-portal bounce)
# is still honoured. Authz still re-reads User from Postgres on every request.
# Raise for fewer session reads; set to 0 to disable the cache entirely.
# SESSION_COOKIE_CACHE_MAX_AGE_SEC=60

# Privileged-role password lockout (admin/super_admin/credit/finance officers).
# PRIVILEGED_LOGIN_MAX_ATTEMPTS=5
# PRIVILEGED_LOGIN_LOCKOUT_SEC=900

# MFA enforcement for privileged ops roles (admin/super_admin/credit/finance).
# Opt-in only. Set MFA_ENFORCE=true to require TOTP for privileged ops roles.
# MFA_ENFORCE=false

# Re-seed Chery inventory on API startup when no published products exist (idempotent).
# SEED_INVENTORY_ON_STARTUP=false
# Optional grace period before blocking API routes without TOTP (ISO 8601 date).
# MFA_GRACE_UNTIL=2026-09-01T00:00:00.000Z

# Product analytics (API logs JSON events; set false to disable).
# PRODUCT_ANALYTICS_ENABLED=true

# Credit approver cannot record down payment / activate same application (default enabled).
# SEPARATION_OF_DUTIES=true

# --- URLs for links in emails / payment redirects ---

# MARKETPLACE_URL=http://localhost:5173
# VITE_MARKETPLACE_URL=http://localhost:5173

# --- Observability ---

# --- Mobile / KYC unification ---

# blox-kyc-module integrator (QID/passport OCR). Leave KYC_API_KEY empty to disable.
KYC_API_BASE_URL=http://localhost:4000
# Dev key — created by `npm run seed:integrator` in blox-kyc-module (Alpha org tenant id).
KYC_API_KEY=kyc_dev_blox_marketplace_integrator_0123456789abcdef
KYC_TENANT_ID=
KYC_WEBHOOK_SECRET=whsec_dev_blox_marketplace_kyc_webhook_0123456789ab
# BRD Qatar e-KYC BR-7/BR-8: identity must come from the KYC platform (OCR + liveness
# + face match). Defaults to true whenever KYC_API_KEY is set; a customer's
# hand-uploaded QID photo then no longer satisfies the identity slot.
# KYC_EKYC_REQUIRED=true
# Face-to-face branch intake: staff may still attach the QID they inspected in person.
# KYC_ALLOW_STAFF_MANUAL_IDENTITY=true

# Production SkipCash gateway (verifyAndComplete). Sandbox remains SKIPCASH_SANDBOX.
# SKIPCASH_API_URL=
# SKIPCASH_API_KEY=
# Mobile checkout (HMAC create/verify — same as legacy Supabase edge functions):
# SKIPCASH_SECRET_KEY=
# SKIPCASH_KEY_ID=
# SKIPCASH_CLIENT_ID=
SKIPCASH_SANDBOX=true
SKIPCASH_SANDBOX_URL=https://skipcashtest.azurewebsites.net
SKIPCASH_PRODUCTION_URL=https://api.skipcash.app

# Default company used when migrating Supabase products without company_id.
# MIGRATION_DEFAULT_COMPANY_ID=

# --- Customer platform: security & privacy baseline ---

# Field-level encryption key for document numbers and other sensitive fields
# (32 bytes, base64 or hex). Required in production; derived from
# BETTER_AUTH_SECRET in development. Generate: openssl rand -base64 32
# FIELD_ENCRYPTION_KEY=

# Session policy (LOS FSD 11.2). Idle timeout is sliding; absolute is from sign-in.
# SESSION_IDLE_TIMEOUT_SEC=600
# SESSION_ABSOLUTE_TIMEOUT_SEC=28800
# SESSION_IDLE_WARNING_SEC=60
# SESSION_SINGLE_PER_USER=true

# Data residency: refuse to boot in production unless S3_REGION is in this list.
# STORAGE_ALLOWED_REGIONS=me-south-1,me-central-1,qa-doha-1

# Outbound SMS: assisted-session / guarantor OTPs and SMS notifications.
# SMS_PROVIDER=log            # log (default) | http | twilio
# SMS_HTTP_URL=               # http: JSON POST endpoint of your SMS gateway adapter
# SMS_HTTP_TOKEN=             # http: Bearer token for that endpoint
# SMS_SENDER_ID=Blox          # http: sender id passed to the adapter
# Twilio (SMS_PROVIDER=twilio; also used by WHATSAPP_PROVIDER=twilio):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+97400000000               # E.164 sender number — or use a Messaging Service instead
# TWILIO_MESSAGING_SERVICE_SID=          # takes precedence over TWILIO_FROM when set
# TWILIO_HTTP_TIMEOUT_MS=10000

# WhatsApp notifications (never OTPs). Sent only to customers who enabled the channel.
# WHATSAPP_PROVIDER=log       # log (default) | twilio | http
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # Twilio WhatsApp sender (prefix optional)
# WHATSAPP_HTTP_URL=          # http: JSON POST `{ to, body, kind, channel: 'whatsapp' }`
# WHATSAPP_HTTP_TOKEN=        # http: Bearer token for that endpoint

# Push notifications to registered device tokens (FCM HTTP v1, no Admin SDK).
# FCM_PROVIDER=log            # log (default) | fcm
# Firebase service-account key: raw JSON or base64 of it, or a file path.
# FCM_SERVICE_ACCOUNT_JSON=
# FCM_SERVICE_ACCOUNT_FILE=/run/secrets/firebase-service-account.json
# FCM_HTTP_TIMEOUT_MS=10000

# Notification router: platform-wide allow-list of outbound channels (in-app is
# always written). Comma-separated subset of email,sms,whatsapp,push; unset means
# all, `none` switches every outbound channel off. Per-customer preferences
# (`channels.*`, `reminders.*`) still apply on top.
# NOTIFICATION_OUTBOUND_CHANNELS=email,sms,whatsapp,push

# Qatar ID at rest. The API always writes users.qid_enc (AES-256-GCM) and
# users.qid_hash (blind index); the plaintext users.qid column is kept in step
# only while this is true. Rollout: deploy → `npm run qid:backfill` → set false
# and redeploy → `npm run qid:drop-plaintext` (refuses to run while true).
# QID_STORE_PLAINTEXT=true

# Product rules: treat financing caps (QAR 50k/70k car, 15k motorcycle) as hard
# blocks instead of review warnings.
# PRODUCT_RULES_ENFORCE_FINANCING_CAPS=false

# Assisted session link lifetime (minutes); the customer must verify the OTP within it.
# ASSIST_SESSION_TTL_MINUTES=120

# Product rules: reject corporate applicants outright (FSD: individuals only).
# Off by default so the existing dealer corporate flow keeps working; when off,
# corporate applications are flagged for credit review instead.
# PRODUCT_RULES_ENFORCE_INDIVIDUALS_ONLY=false

# Reminder crons (customer platform): document expiry (60/30/7 days) and takaful renewal (30/14/3 days).
# DOCUMENT_EXPIRY_REMINDERS_CRON=0 7 * * *
# TAKAFUL_REMINDERS_CRON=0 7 * * *
