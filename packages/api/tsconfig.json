{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@drivemarket/shared/pricing": [
        "../shared/src/lib/pricing.ts"
      ],
      "@drivemarket/shared/installment-plan": [
        "../shared/src/lib/installment-plan-server.ts"
      ],
      "@drivemarket/shared/installment-plan-utils": [
        "../shared/src/lib/installment-plan-utils.ts"
      ],
      "@drivemarket/shared/tenure": [
        "../shared/src/lib/tenure.ts"
      ],
      "@drivemarket/shared/domain-rules": [
        "../shared/src/lib/domain-rules-server.ts"
      ],
      "@drivemarket/shared/units": [
        "../shared/src/lib/units.ts"
      ],
      "@drivemarket/shared/application-status-map": [
        "../shared/src/lib/application-status-map.ts"
      ],
      "@drivemarket/shared/ownership": [
        "../shared/src/lib/ownership.ts"
      ]
    }
  },
  "include": [
    "src/**/*",
    "prisma/seed.ts",
    "prisma/seed-chery.ts",
    "prisma/seed-finance-partners.ts",
    "prisma/seed-qauto-inventory.ts",
    "prisma/upload-qauto-listing-images.ts",
    "prisma/bootstrap-qauto.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts"
  ]
}
