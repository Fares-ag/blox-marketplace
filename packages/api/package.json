{
  "name": "@drivemarket/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start:dev": "tsx watch src/main.ts",
    "build": "prisma generate && npm run build:installment-plan -w @drivemarket/shared && npm run build:tenure -w @drivemarket/shared && nest build",
    "start": "tsx dist/api/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "ensure:seed-users": "node scripts/ensure-seed-users.mjs",
    "db:backfill-installment-plan": "tsx scripts/backfill-installment-plan.ts",
    "bootstrap:qauto": "tsx scripts/bootstrap-qauto.ts",
    "seed:qauto-inventory": "tsx scripts/seed-qauto-inventory.ts",
    "seed:qauto": "tsx scripts/run-qauto-seed.mjs",
    "seed:qauto:production": "node scripts/seed-qauto-production.mjs",
    "upload:qauto-images": "tsx scripts/upload-qauto-listing-images.ts",
    "upload:qauto:production": "node scripts/upload-qauto-images-production.mjs",
    "generate:qauto-import": "node scripts/generate-qauto-import-json.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "@drivemarket/shared": "*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@prisma/client": "^6.4.0",
    "@sentry/node": "^10.70.0",
    "better-auth": "^1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.5",
    "pdf-lib": "^1.17.1",
    "rate-limit-redis": "^4.3.1",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.2.1",
    "@swc/core": "^1.16.1",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.1",
    "prisma": "^6.4.0",
    "supertest": "^7.2.2",
    "testcontainers": "^12.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "unplugin-swc": "^1.5.11",
    "vitest": "^3.2.7"
  }
}
