{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "entryFile": "api/src/main",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "applications/documents/templates/**/*",
        "watchAssets": true
      },
      {
        "include": "applications/documents/brand/**/*",
        "watchAssets": true
      }
    ]
  }
}
