{
  "name": "@drivemarket/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./pricing": {
      "types": "./src/lib/pricing.ts",
      "import": "./src/lib/pricing.ts",
      "require": "./dist/lib/pricing.cjs",
      "default": "./src/lib/pricing.ts"
    },
    "./installment-plan": {
      "types": "./src/lib/installment-plan-server.ts",
      "import": "./src/lib/installment-plan-server.ts",
      "require": "./dist/lib/installment-plan.cjs",
      "default": "./src/lib/installment-plan-server.ts"
    },
    "./installment-plan-utils": {
      "types": "./src/lib/installment-plan-utils.ts",
      "import": "./src/lib/installment-plan-utils.ts",
      "require": "./dist/lib/installment-plan.cjs",
      "default": "./src/lib/installment-plan-utils.ts"
    },
    "./styles/global.scss": "./src/styles/global.scss",
    "./styles/blox-ops.scss": "./src/styles/blox-ops.scss",
    "./i18n": "./src/i18n/index.ts",
    "./analytics/events": "./src/analytics/events.ts",
    "./analytics/track": "./src/analytics/track.ts",
    "./tenure": {
      "types": "./src/lib/tenure.ts",
      "import": "./src/lib/tenure.ts",
      "require": "./dist/lib/tenure.cjs",
      "default": "./src/lib/tenure.ts"
    },
    "./domain-rules": {
      "types": "./src/lib/domain-rules-server.ts",
      "import": "./src/lib/domain-rules-server.ts",
      "require": "./dist/lib/domain-rules.cjs",
      "default": "./src/lib/domain-rules-server.ts"
    },
    "./units": {
      "types": "./src/lib/units.ts",
      "import": "./src/lib/units.ts",
      "require": "./dist/lib/units.cjs",
      "default": "./src/lib/units.ts"
    },
    "./application-status-map": {
      "types": "./src/lib/application-status-map.ts",
      "import": "./src/lib/application-status-map.ts",
      "require": "./dist/lib/application-status-map.cjs",
      "default": "./src/lib/application-status-map.ts"
    },
    "./ownership": {
      "types": "./src/lib/ownership.ts",
      "import": "./src/lib/ownership.ts",
      "require": "./dist/lib/ownership.cjs",
      "default": "./src/lib/ownership.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:pricing": "tsc -p tsconfig.pricing.json && node -e \"require('node:fs').renameSync('dist/lib/pricing.js','dist/lib/pricing.cjs')\"",
    "build:installment-plan": "npx --yes esbuild@0.25.0 src/lib/installment-plan-server.ts --bundle --platform=node --format=cjs --outfile=dist/lib/installment-plan.cjs",
    "test": "vitest run",
    "lint": "eslint .",
    "build:tenure": "npx --yes esbuild@0.25.0 src/lib/tenure.ts --bundle --platform=node --format=cjs --outfile=dist/lib/tenure.cjs",
    "build:domain-rules": "npx --yes esbuild@0.25.0 src/lib/domain-rules-server.ts --bundle --platform=node --format=cjs --outfile=dist/lib/domain-rules.cjs",
    "build:application-status-map": "npx --yes esbuild@0.25.0 src/lib/application-status-map.ts --bundle --platform=node --format=cjs --outfile=dist/lib/application-status-map.cjs",
    "build:units": "npx --yes esbuild@0.25.0 src/lib/units.ts --bundle --platform=node --format=cjs --outfile=dist/lib/units.cjs",
    "build:ownership": "npx --yes esbuild@0.25.0 src/lib/ownership.ts --bundle --platform=node --format=cjs --outfile=dist/lib/ownership.cjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@mui/x-date-pickers": "^9.12.0",
    "@sentry/react": "^10.70.0",
    "@tanstack/react-query": "^5.66.0",
    "chart.js": "^4.5.1",
    "i18next": "^26.3.6",
    "lucide-react": "^1.41.0",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.86.0",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^6.29.0",
    "react-toastify": "^11.1.0",
    "yup": "^1.7.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "sass": "^1.83.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  }
}
